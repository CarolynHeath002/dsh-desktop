# Fork packaging preset for unsigned GitHub Actions builds. The machine presets
# this file replaces belong to the upstream self-hosted runner and are not in
# the repository. Both sealed origins use a reserved, non-routable name (RFC
# 2606 .invalid): the runtime update coordinator fails closed on a constant
# gate, and the mandatory-policy channel can only reach DNS NXDOMAIN, so no
# request payload ever leaves the machine.
DSH_DESKTOP_APP_ID=com.carolynheath002.dshdesktop
DSH_DESKTOP_AUTO_UPDATE_ENV=test
DOWNLOAD_TEST_ORIGIN=https://dsh-update.invalid
DOWNLOAD_TEST_RELEASE_ID=00000000000000000000000000000000
DSH_DESKTOP_MANDATORY_UPDATE_TEST_ORIGIN=https://dsh-policy.invalid
DSH_DESKTOP_MANDATORY_UPDATE_CONFIG={"allowedAuthOrigins":["https://dsh-policy.invalid"]}
